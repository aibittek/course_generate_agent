# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Node
node_modules/
*.log

# Course outputs
# courses/
courses_archive/

# Media outputs
*.mp4
*.mp3
*.wav
*.png
*.jpg
*.pdf
# 课程资源 assets 图片（不排除）
!courses/**/assets/**/*.png
!courses/**/assets/**/*.jpg
# training 目录下的课件视频、PDF 与截图保留在 git
!training/**/*.mp4
!training/**/*.pdf
!training/**/*.png
!training/**/*.jpg
# 分享打包 zip 不入库
*.html.zip

# AI Models
models/

# Temp
temp/
tmp/
*.tmp

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Claude Code (project definition - DO NOT IGNORE)
.claude/agent-memory/        # Agent runtime memory (generated)
.claude/settings.local.json # Local overrides

# Environment (DO NOT commit secrets)
.env
.env.local

# Source codes (temporary ignore for commit)
source-codes/
src/
.claude/settings.local.json

# ROS2 workspace (build/install/log artifacts are typically regenerated)
ros2_ws/
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# Windows Zone.Identifier metadata
*:Zone.Identifier
*.Zone.Identifier

# 行业课程案例（大文件/LFS，不入库）
/行业课程案例/
