</main>
</div>
<script>
var ROUTES={
  th:'<span class="dim">// 分类中…</span>\n<span class="ok">✓ 用【.msg 自定义消息】</span>\n<span class="dim">草案 msg/TemperatureHumidity：</span>\n<span class="y">float32 temperature   # 温度(℃)</span>\n<span class="y">float32 humidity      # 湿度(%)</span>\n<span class="dim">理由：两个值语义关联（同一采样周期），拆成两个 Float32 话题会失去原子性。</span>',
  vf:'<span class="dim">// 分类中…</span>\n<span class="ok">✓ 用【.srv 服务】</span>\n<span class="dim">草案 srv/VerifyFingerprint：</span>\n<span class="y">---              # 请求为空（触发即验证）</span>\n<span class="y">bool success</span>\n<span class="y">int32 user_id</span>\n<span class="y">string message</span>\n<span class="dim">理由：一次性一问一答、需要明确成败、无中间过程 → 同步 RPC。</span>',
  rf:'<span class="dim">// 分类中…</span>\n<span class="ok">✓ 用【.action 动作】</span>\n<span class="dim">草案 action/RfidScan：</span>\n<span class="y">---\nint32 timeout_sec      # Goal：可配超时</span>\n<span class="y">---\nbool success\nstring card_uid        # Result：四字段</span>\n<span class="y">---\nstring status          # Feedback：状态流</span>\n<span class="dim">理由：耗时不可知 + 要过程反馈 + 可取消——三段结构一一对应。</span>',
  std:'<span class="dim">// 分类中…</span>\n<span class="ok">✓ 用【标准消息 std_msgs/msg/Float32】</span>\n<span class="dim">单值定长、生态通用（rosbag/rqt 开箱即用），自定义反而增加对接成本。</span>\n<span class="dim">何时升级自定义：ppm+电压+ADC 三值语义绑定时 → msg/GasReading。</span>',
  relay:'<span class="dim">// 分类中…</span>\n<span class="ok">✓ 用【.srv 服务】</span>\n<span class="dim">草案 srv/TriggerRelay：</span>\n<span class="y">int32 relay_id      # 继电器编号</span>\n<span class="y">float32 duration    # 吸合时长(秒)</span>\n<span class="y">---</span>\n<span class="y">bool success\nstring message</span>\n<span class="dim">理由：短耗时、确定性执行、要回执 → 同步 RPC（对应 EXP-07 relay 控制实为服务场景）。</span>'
};
function routeIf(){document.getElementById('ifIo').innerHTML=ROUTES[document.getElementById('req').value];}
routeIf();
</script>
<script src="../shared/tutorial.js" defer></script>
</body>
</html>