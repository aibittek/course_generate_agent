<?xml version="1.0" encoding="utf-8"?>
<!--
  simple-arm.urdf —— 课程用 5 自由度机械臂（教学简化版）

  三条硬规则（改版请守住）：
    1. 只用 <box>/<cylinder>/<sphere> 基本体，不依赖任何 STL 网格。
       文件 10 KB 左右，改一个数字就能改模型，复用到别的课很方便。
    2. 严格共轴：所有转动关节的轴线都通过同一条竖直线，每段连杆居中在关节中心，
       横向偏置一律为 0。零位（全部关节角 = 0）时整条臂立成一根笔直的柱子。
    3. 坐标系原点放在"有物理意义的位置"：
         base_footprint  地面
         base_link       底盘安装面（地面）
         arm_base_link   立柱与底盘的安装面
         arm_link1~5     各自关节的转轴中心   ← 坐标帧就画在关节正中
         tcp_link        两指尖之间的夹持点

  与真机 car1.urdf 的关系：
    关节链、转轴方向（J1/J5 绕 Z，J2/J3/J4 绕 Y）、各段长度完全一致；
    真机上底座偏装 56.6 mm、J2 处 +25 mm、J5 处 −25.3 mm 这些毫米级装配偏置，
    教学版全部归零 —— 它们对 FK 规律没有影响，却会让模型看起来"每段都错位"。

  关节链：
    base_footprint → base_link          base_joint       fixed
    base_link      → arm_base_link      arm_base_joint   fixed    立柱
    arm_base_link  → arm_link1          arm_joint1       rev Z    J1 转台（航向）
    arm_link1      → arm_link2          arm_joint2       rev Y    J2 大臂
    arm_link2      → arm_link3          arm_joint3       rev Y    J3 小臂
    arm_link3      → arm_link4          arm_joint4       rev Y    J4 工具段
    arm_link4      → arm_link5          arm_joint5       rev Z    J5 夹爪朝向
    arm_link5      → tcp_link           tcp_joint        fixed    指尖 TCP

  各关节在 base_footprint 下的高度（m）：
    J1 0.1295   J2 0.1890   J3 0.3151   J4 0.4413   J5 0.5157   TCP 0.5919
  各段长度：L1 = L2 = 0.12614，工具段 0.07439，TCP 段 0.07625

  坐标轴约定（REP-103，ROS 官方规范）：
    X 轴向前（车头方向）· Y 轴向左 · Z 轴向上 · 右手系（X × Y = Z）
    所有 link 的 rpy 都是 0 0 0，所以每个 link 的坐标轴都与 base_footprint 同向，
    转动关节只是在"转轴方向上"叠加一个角度，不会引入额外的坐标翻转。

  转轴方向（统一且符合右手定则）：
    J1  arm_joint1  axis 0 0 1（+Z）  从上方看逆时针为正 —— 臂向左转
    J2  arm_joint2  axis 0 1 0（+Y）  正角把大臂朝 +X 前方放倒
    J3  arm_joint3  axis 0 1 0（+Y）  同上
    J4  arm_joint4  axis 0 1 0（+Y）  同上
    J5  arm_joint5  axis 0 0 1（+Z）  从上方看逆时针为正 —— 夹爪绕自身轴线转
    规律：绕 Z 的（J1/J5）是"转圈"，绕 Y 的（J2/J3/J4）是"举手/放手"，
    同一类关节用同一根轴、同一个正方向，和真机 car1.urdf 完全一致。
-->
<robot name="simple_arm">

  <!-- ============ 0. 地面基准（无实体，仅坐标原点） ============ -->
  <link name="base_footprint" />

  <!-- ============ 1. 底盘 base_link（原点在地面，几何全部往上长） ============ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.007" rpy="0 0 0" />
      <geometry><cylinder radius="0.088" length="0.014" /></geometry>
      <material name="plate"><color rgba="0.45 0.50 0.56 1" /></material>
    </visual>
    <visual>
      <origin xyz="0 0 0.017" rpy="0 0 0" />
      <geometry><cylinder radius="0.077" length="0.008" /></geometry>
      <material name="plate_light"><color rgba="0.62 0.67 0.73 1" /></material>
    </visual>
  </link>

  <joint name="base_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_footprint" />
    <child link="base_link" />
  </joint>

  <!-- ============ 2. 立柱 arm_base_link（原点=立柱与底盘的安装面，与 J1 同轴） ============ -->
  <link name="arm_base_link">
    <!-- 底部法兰：坐在底盘顶面（世界 0.020 ~ 0.033） -->
    <visual>
      <origin xyz="0 0 0.0065" rpy="0 0 0" />
      <geometry><cylinder radius="0.040" length="0.013" /></geometry>
      <material name="plate_light"><color rgba="0.62 0.67 0.73 1" /></material>
    </visual>
    <!-- 立柱本体（世界 0.032 ~ 0.124，与法兰、轴承各重叠 1 mm） -->
    <visual>
      <origin xyz="0 0 0.0571" rpy="0 0 0" />
      <geometry><cylinder radius="0.026" length="0.0912" /></geometry>
      <material name="plate_light"><color rgba="0.62 0.67 0.73 1" /></material>
    </visual>
    <!-- J1 回转轴承：比转台更宽的一圈，露在转台外面，一眼看出"这里能转" -->
    <visual>
      <origin xyz="0 0 0.1005" rpy="0 0 0" />
      <geometry><cylinder radius="0.037" length="0.013" /></geometry>
      <material name="dark"><color rgba="0.36 0.41 0.47 1" /></material>
    </visual>
  </link>

  <joint name="arm_base_joint" type="fixed">
    <origin xyz="0 0 0.0205" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="arm_base_link" />
  </joint>

  <!-- ============ 3. J1 转台 arm_link1（原点=J1 轴心，绕 Z 转 = 航向角） ============ -->
  <link name="arm_link1">
    <!-- 转台盘：以 J1 轴为中心，上下各 13 mm -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><cylinder radius="0.032" length="0.026" /></geometry>
      <material name="joint"><color rgba="0.60 0.64 0.70 1" /></material>
    </visual>
    <!-- 朝向标记：俯视时用来分辨转台转到哪个方向 -->
    <visual>
      <origin xyz="0.030 0 0.004" rpy="0 0 0" />
      <geometry><box size="0.014 0.014 0.012" /></geometry>
      <material name="red"><color rgba="0.85 0.23 0.23 1" /></material>
    </visual>
    <!-- J1 → J2 立柱：沿 J1 轴竖直向上，与 J2 轴心同轴 -->
    <visual>
      <origin xyz="0 0 0.03425" rpy="0 0 0" />
      <geometry><cylinder radius="0.020" length="0.0465" /></geometry>
      <material name="joint"><color rgba="0.60 0.64 0.70 1" /></material>
    </visual>
  </link>

  <joint name="arm_joint1" type="revolute">
    <origin xyz="0 0 0.109" rpy="0 0 0" />
    <parent link="arm_base_link" />
    <child link="arm_link1" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="1" />
  </joint>

  <!-- ============ 4. J2 arm_link2（原点=J2 轴心，绕 Y 俯仰）+ 大臂 L1 ============ -->
  <link name="arm_link2">
    <!-- 关节壳：圆柱默认沿 Z，绕 X 转 90° 变沿 Y，横躺成俯仰轴的样子 -->
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0" />
      <geometry><cylinder radius="0.023" length="0.046" /></geometry>
      <material name="joint"><color rgba="0.60 0.64 0.70 1" /></material>
    </visual>
    <!-- 大臂：从 J2 中心到 J3 中心，严格沿 Z -->
    <visual>
      <origin xyz="0 0 0.06307" rpy="0 0 0" />
      <geometry><cylinder radius="0.0155" length="0.12614" /></geometry>
      <material name="red"><color rgba="0.85 0.23 0.23 1" /></material>
    </visual>
  </link>

  <joint name="arm_joint2" type="revolute">
    <origin xyz="0 0 0.0595" rpy="0 0 0" />
    <parent link="arm_link1" />
    <child link="arm_link2" />
    <axis xyz="0 1 0" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="1" />
  </joint>

  <!-- ============ 5. J3 arm_link3（原点=J3 轴心，绕 Y 俯仰）+ 小臂 L2 ============ -->
  <link name="arm_link3">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0" />
      <geometry><cylinder radius="0.0195" length="0.040" /></geometry>
      <material name="joint"><color rgba="0.60 0.64 0.70 1" /></material>
    </visual>
    <!-- 小臂：从 J3 中心到 J4 中心，严格沿 Z -->
    <visual>
      <origin xyz="0 0 0.06307" rpy="0 0 0" />
      <geometry><cylinder radius="0.0135" length="0.12614" /></geometry>
      <material name="orange"><color rgba="0.91 0.60 0.13 1" /></material>
    </visual>
  </link>

  <joint name="arm_joint3" type="revolute">
    <origin xyz="0 0 0.12614" rpy="0 0 0" />
    <parent link="arm_link2" />
    <child link="arm_link3" />
    <axis xyz="0 1 0" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="1" />
  </joint>

  <!-- ============ 6. J4 arm_link4（原点=J4 轴心，绕 Y 俯仰）+ 工具段 ============ -->
  <link name="arm_link4">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0" />
      <geometry><cylinder radius="0.0165" length="0.036" /></geometry>
      <material name="joint"><color rgba="0.60 0.64 0.70 1" /></material>
    </visual>
    <!-- 工具段：从 J4 中心到 J5 中心，严格沿 Z -->
    <visual>
      <origin xyz="0 0 0.037195" rpy="0 0 0" />
      <geometry><cylinder radius="0.0115" length="0.07439" /></geometry>
      <material name="purple"><color rgba="0.49 0.36 0.84 1" /></material>
    </visual>
  </link>

  <joint name="arm_joint4" type="revolute">
    <origin xyz="0 0 0.12614" rpy="0 0 0" />
    <parent link="arm_link3" />
    <child link="arm_link4" />
    <axis xyz="0 1 0" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="1" />
  </joint>

  <!-- ============ 7. J5 arm_link5（原点=J5 轴心，绕 Z 转 = 夹爪朝向）+ 夹爪 ============ -->
  <link name="arm_link5">
    <!-- 腕壳：以 J5 轴为中心，上下各 13 mm -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><cylinder radius="0.015" length="0.026" /></geometry>
      <material name="grip"><color rgba="0.28 0.33 0.40 1" /></material>
    </visual>
    <!-- 掌：坐在腕壳顶面上，两侧对称 -->
    <visual>
      <origin xyz="0 0 0.021" rpy="0 0 0" />
      <geometry><box size="0.032 0.048 0.016" /></geometry>
      <material name="grip"><color rgba="0.28 0.33 0.40 1" /></material>
    </visual>
    <!-- 两根手指：沿 Y 方向左右分开（不是上下开合），关于中心线对称，指尖伸过 TCP -->
    <visual>
      <origin xyz="0 0.017 0.056" rpy="0 0 0" />
      <geometry><box size="0.018 0.009 0.054" /></geometry>
      <material name="grip"><color rgba="0.28 0.33 0.40 1" /></material>
    </visual>
    <visual>
      <origin xyz="0 -0.017 0.056" rpy="0 0 0" />
      <geometry><box size="0.018 0.009 0.054" /></geometry>
      <material name="grip"><color rgba="0.28 0.33 0.40 1" /></material>
    </visual>
  </link>

  <joint name="arm_joint5" type="revolute">
    <origin xyz="0 0 0.07439" rpy="0 0 0" />
    <parent link="arm_link4" />
    <child link="arm_link5" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="100" velocity="1" />
  </joint>

  <!-- ============ 8. 指尖 TCP（无实体，两指之间的夹持点） ============ -->
  <link name="tcp_link" />

  <joint name="tcp_joint" type="fixed">
    <origin xyz="0 0 0.07625" rpy="0 0 0" />
    <parent link="arm_link5" />
    <child link="tcp_link" />
  </joint>

</robot>
