# ============================================================
# 源码HOOK强制检查脚本
# 触发：Claude Code PreToolUse (Task工具)
# 输入：stdin JSON
# 退出：0=通过 / 2=阻止
# ============================================================

$InputJson = [Console]::In.ReadToEnd()

if ([string]::IsNullOrEmpty($InputJson)) {
    exit 0
}

try {
    $Input = $InputJson | ConvertFrom-Json
} catch {
    exit 0
}

if ($Input.tool_name -ne "Task") {
    exit 0
}

$AgentName = $Input.tool_input.subagent_type
$Prompt = $Input.tool_input.prompt

# 提取课程ID和实验ID
$CourseId = ""
$ExperimentId = ""

# 提取课程ID (EXP001-EXP007 或 IND001-IND004)
if ($Prompt -match '(EXP\d{3}|IND\d{3})') {
    $CourseId = $Matches[1]
} elseif ($Prompt -match 'course_id["\s:=]+([A-Z]+\d{3})') {
    $CourseId = $Matches[1]
}

# 提取实验ID
if ($Prompt -match '实验\s*(\d+)') {
    $ExperimentId = $Matches[1]
} elseif ($Prompt -match 'experiment_id["\s:=]+(\d+)') {
    $ExperimentId = $Matches[1]
} elseif ($Prompt -match 'exp(\d+)') {
    $ExperimentId = $Matches[1]
}

if ([string]::IsNullOrEmpty($ExperimentId)) {
    exit 0
}

# 课程ID到文件夹映射
$CourseMapping = @{
    "EXP001" = "sheet1/cv_practice"
    "EXP002" = "sheet1/speech_practice"
    "EXP003" = "sheet1/ros_practice"
    "EXP004" = "sheet1/slam_practice"
    "EXP005" = "sheet1/arm_practice"
    "EXP006" = "sheet1/llm_practice"
    "EXP007" = "sheet1/training"
    "IND001" = "sheet2/sorting_scene"
    "IND002" = "sheet2/manufacturing_scene"
    "IND003" = "sheet2/home_scene"
    "IND004" = "sheet2/inspection_scene"
}

$CourseFolder = ""
if (-not [string]::IsNullOrEmpty($CourseId) -and $CourseMapping.ContainsKey($CourseId)) {
    $CourseFolder = $CourseMapping[$CourseId]
} else {
    # 如果无法识别课程ID，默认使用cv_practice（向后兼容）
    $CourseFolder = "sheet1/cv_practice"
}

$BaseDir = "e:\Source\xflz_eai_car1\course_generate_agent\courses"
$CoursePath = Join-Path $BaseDir $CourseFolder
$RegistryPath = Join-Path $CoursePath "source-codes\_registry.yaml"
$AnalysisStatusPath = Join-Path $CoursePath "source-codes\exp$($ExperimentId.PadLeft(2, '0'))\code-analysis\analysis-status.yaml"

Write-Host "===============================================" -ForegroundColor Cyan
Write-Host "[HOOK] Source code check" -ForegroundColor Cyan
Write-Host "[HOOK] Agent: $AgentName" -ForegroundColor Gray
Write-Host "[HOOK] Course: $CourseId -> $CourseFolder" -ForegroundColor Gray
Write-Host "[HOOK] ExpId: $ExperimentId" -ForegroundColor Gray
Write-Host "===============================================" -ForegroundColor Cyan

if (-not (Test-Path $RegistryPath)) {
    Write-Host "[BLOCK] Registry not found" -ForegroundColor Red
    exit 2
}

if (-not (Test-Path $AnalysisStatusPath)) {
    Write-Host "[BLOCK] Analysis status not found" -ForegroundColor Red
    exit 2
}

try {
    $StatusContent = Get-Content $AnalysisStatusPath -Raw
    $StatusLine = ($StatusContent -split "`n" | Where-Object { $_ -match "^\s*analysis_status\s*:" } | Select-Object -First 1)
    $Status = ($StatusLine -replace ".*analysis_status\s*:\s*", "").Trim()

    Write-Host "[HOOK] Status: $Status" -ForegroundColor Gray

    if ($Status -eq "completed") {
        Write-Host "[PASS]" -ForegroundColor Green
        exit 0
    } elseif ($Status -eq "analyzing") {
        Write-Host "[WAIT]" -ForegroundColor Yellow
        exit 2
    } elseif ($Status -eq "pending") {
        Write-Host "[BLOCK] Analysis not started" -ForegroundColor Red
        exit 2
    } elseif ($Status -eq "failed") {
        Write-Host "[BLOCK] Analysis failed" -ForegroundColor Red
        exit 2
    } else {
        Write-Host "[BLOCK] Unknown status: $Status" -ForegroundColor Red
        exit 2
    }
} catch {
    Write-Host "[BLOCK] Read error" -ForegroundColor Red
    exit 2
}
