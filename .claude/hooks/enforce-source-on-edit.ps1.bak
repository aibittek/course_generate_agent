# ============================================================
# Source-code enforcement hook (Edit/Write/MultiEdit variant)
# PreToolUse hook for Claude Code
# stdin: JSON payload
# exit:  0 = allow, 2 = block
#
# KNOWN LIMITATION (PowerShell 5.1 on Windows):
# Chinese character matching fails due to stdin encoding issue
# (PS 5.1 decodes UTF-8 stdin as GBK, corrupting "实验" → "瀹為獙").
# Hook currently only matches English "Experiment N" pattern.
# For full protection, upgrade to PowerShell Core (pwsh.exe) or
# manually verify edits to lab_guide.md files.
# ============================================================

$InputJson = [Console]::In.ReadToEnd()

if ([string]::IsNullOrEmpty($InputJson)) {
    exit 0
}

try {
    $Payload = $InputJson | ConvertFrom-Json
} catch {
    exit 0
}

$ToolName = $Payload.tool_name
if ($ToolName -ne "Edit" -and $ToolName -ne "Write" -and $ToolName -ne "MultiEdit") {
    exit 0
}

$FilePath = $Payload.tool_input.file_path
if ([string]::IsNullOrEmpty($FilePath)) {
    exit 0
}

# Only intercept courses/<sheet>/<folder>/<...>_lab_guide.md
$NormPath = $FilePath -replace '\\', '/'
if ($NormPath -notmatch 'courses/(sheet[12])/([^/]+)/[^/]*_lab_guide\.md$') {
    exit 0
}
$Sheet = $Matches[1]
$CourseFolder = "$Sheet/$($Matches[2])"

# course_folder -> course_id mapping
$FolderToCourse = @{
    "sheet1/cv_practice"          = "EXP001"
    "sheet1/speech_practice"      = "EXP002"
    "sheet1/ros_practice"         = "EXP003"
    "sheet1/slam_practice"        = "EXP004"
    "sheet1/arm_practice"         = "EXP005"
    "sheet1/llm_practice"         = "EXP006"
    "sheet1/training"             = "EXP007"
    "sheet2/sorting_scene"        = "IND001"
    "sheet2/manufacturing_scene"  = "IND002"
    "sheet2/home_scene"           = "IND003"
    "sheet2/inspection_scene"     = "IND004"
}

if (-not $FolderToCourse.ContainsKey($CourseFolder)) {
    exit 0
}
$CourseId = $FolderToCourse[$CourseFolder]

# Collect all candidate text payloads
$TextChunks = New-Object System.Collections.Generic.List[string]
if ($null -ne $Payload.tool_input.old_string)  { $TextChunks.Add([string]$Payload.tool_input.old_string) }
if ($null -ne $Payload.tool_input.new_string)  { $TextChunks.Add([string]$Payload.tool_input.new_string) }
if ($null -ne $Payload.tool_input.content)     { $TextChunks.Add([string]$Payload.tool_input.content) }
if ($null -ne $Payload.tool_input.edits) {
    foreach ($e in $Payload.tool_input.edits) {
        if ($null -ne $e.old_string) { $TextChunks.Add([string]$e.old_string) }
        if ($null -ne $e.new_string) { $TextChunks.Add([string]$e.new_string) }
    }
}

# Match experiment references: "Experiment N"
# NOTE: Chinese "实验N" pattern disabled due to PS 5.1 encoding issue
$ExpIds = New-Object System.Collections.Generic.HashSet[int]
$Pattern = "(?:##\s*)?Experiment\s*(\d+)"
$ExpRegex = [regex]$Pattern
foreach ($chunk in $TextChunks) {
    foreach ($m in $ExpRegex.Matches($chunk)) {
        [void]$ExpIds.Add([int]$m.Groups[1].Value)
    }
}

if ($ExpIds.Count -eq 0) {
    # Edit does not touch any experiment heading -> allow
    # (or uses Chinese heading which we cannot detect reliably)
    exit 0
}

$BaseDir   = "e:\Source\xflz_eai_car1\course_generate_agent\courses"
$CoursePath = Join-Path $BaseDir $CourseFolder
$RegistryPath = Join-Path $CoursePath "source-codes\_registry.yaml"

Write-Host "===============================================" -ForegroundColor Cyan
Write-Host "[HOOK-EDIT] Source code check" -ForegroundColor Cyan
Write-Host "[HOOK-EDIT] Tool : $ToolName" -ForegroundColor Gray
Write-Host "[HOOK-EDIT] File : $FilePath" -ForegroundColor Gray
Write-Host "[HOOK-EDIT] Crs  : $CourseId -> $CourseFolder" -ForegroundColor Gray
Write-Host "[HOOK-EDIT] Exps : $([string]::Join(',', $ExpIds))" -ForegroundColor Gray
Write-Host "===============================================" -ForegroundColor Cyan

if (-not (Test-Path $RegistryPath)) {
    Write-Host "[BLOCK] Registry not found: $RegistryPath" -ForegroundColor Red
    exit 2
}

foreach ($id in $ExpIds) {
    $idPad = ([string]$id).PadLeft(2, '0')
    $StatusFile = Join-Path $CoursePath "source-codes\exp$idPad\code-analysis\analysis-status.yaml"

    if (-not (Test-Path $StatusFile)) {
        Write-Host "[BLOCK] $CourseId exp$idPad analysis-status.yaml not found" -ForegroundColor Red
        Write-Host "        expected: $StatusFile" -ForegroundColor Red
        exit 2
    }

    try {
        $StatusContent = Get-Content $StatusFile -Raw
        $StatusLine = ($StatusContent -split "`n" | Where-Object { $_ -match "^\s*analysis_status\s*:" } | Select-Object -First 1)
        $Status = ($StatusLine -replace ".*analysis_status\s*:\s*", "").Trim()
    } catch {
        Write-Host "[BLOCK] $CourseId exp$idPad read error" -ForegroundColor Red
        exit 2
    }

    Write-Host "[HOOK-EDIT] exp$idPad status=$Status" -ForegroundColor Gray

    if ($Status -ne "completed") {
        Write-Host "[BLOCK] $CourseId exp$idPad source analysis NOT completed (status=$Status)" -ForegroundColor Red
        Write-Host "        Run SourceCodeAnalysisAgent first to produce code-analysis-report.md" -ForegroundColor Red
        exit 2
    }
}

Write-Host "[PASS]" -ForegroundColor Green
exit 0
